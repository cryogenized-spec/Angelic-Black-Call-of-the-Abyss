<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Angelic Black; Call of the Abyss</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/press-start-2p@latest/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/grenze-gotisch@latest/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/eb-garamond@latest/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/unifrakturmaguntia@latest/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/noto-serif-jp@latest/index.css">
<style>
  html,body{margin:0;padding:0;height:100%;background:#05030a;overflow:hidden}
  body{display:flex;align-items:center;justify-content:center}
  #stage{position:relative;container-type:size;box-shadow:0 0 70px rgba(90,40,160,.35)}
  #stage::after{content:'';position:absolute;inset:0;pointer-events:none;z-index:3;
    background:radial-gradient(ellipse at center, transparent 55%, rgba(5,0,15,.5) 100%)}
  #gameCanvas{display:block;width:100%;height:100%;image-rendering:pixelated;background:#0d0719;transition:filter .3s ease}
  [hidden]{display:none!important}

  /* ============ COVER / TITLE ============ */
  #coverScreen{position:absolute;inset:0;z-index:30;transition:opacity .9s ease;
    background:radial-gradient(120% 90% at 50% 20%, #241239 0%, #0d0719 55%, #05030a 100%)}
  #coverScreen.gone{opacity:0;pointer-events:none}
  #coverScreen.pulse{animation:coverPulse .3s ease}
  @keyframes coverPulse{0%{filter:brightness(1)}40%{filter:brightness(1.45)}100%{filter:brightness(1)}}
  #coverArt{position:absolute;inset:0;background-size:cover;background-position:50% 40%;background-repeat:no-repeat}
  #coverShade{position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(to top, rgba(4,2,9,.96) 0%, rgba(4,2,9,.6) 24%, transparent 48%)}
  #coverVeil{position:absolute;inset:0;background:#020105;opacity:1;transition:opacity 1s ease;pointer-events:none}
  #grain{position:absolute;inset:0;opacity:.06;pointer-events:none;animation:grainShift .5s steps(2) infinite}
  @keyframes grainShift{from{background-position:0 0}to{background-position:64px 32px}}
  #coverTitle{position:absolute;left:0;right:0;bottom:3%;display:flex;flex-direction:column;align-items:center;gap:1.4cqw;text-align:center;pointer-events:none}
  .ct-main{font-family:'UnifrakturMaguntia',serif;font-size:13.5cqw;line-height:1;
    background:linear-gradient(180deg,#e6dcff 0%,#b18cff 30%,#7a3cf0 60%,#5b21c9 82%,#8f66ff 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:2px 0 0 #eef2fa,-2px 0 0 #eef2fa,0 2px 0 #eef2fa,0 -2px 0 #eef2fa,
      1.5px 1.5px 0 #eef2fa,-1.5px 1.5px 0 #eef2fa,1.5px -1.5px 0 #eef2fa,-1.5px -1.5px 0 #eef2fa,
      0 5px 0 #10091f,0 0 22px rgba(140,90,255,.65)}
  .ct-sub{font-family:'EB Garamond',serif;font-size:4.8cqw;letter-spacing:.3em;color:#cfc3f0;display:flex;align-items:center;gap:2cqw;text-shadow:0 2px 0 #000}
  .ct-sub .orn{position:relative;width:7cqw;height:1px;background:#cfc3f0;opacity:.85}
  .ct-sub .orn::before{content:'';position:absolute;left:50%;top:50%;width:1.4cqw;height:1.4cqw;background:#cfc3f0;transform:translate(-50%,-50%) rotate(45deg)}
  #ctSig{position:relative;width:86%;height:10cqw;margin-top:.6cqw;transform:rotate(-1.2deg)}
  #ctSig .cloud{position:absolute;inset:0;filter:drop-shadow(0 0 1px #eef2fa) drop-shadow(0 0 2px #eef2fa) drop-shadow(0 0 7px rgba(214,224,244,.5))}
  #ctSig .cloud i{position:absolute;background:#07070c;border-radius:999px}
  #ctSig .band{left:3%;right:6%;top:32%;bottom:20%}
  #ctSig .b1{left:7%;top:8%;width:14%;height:56%}
  #ctSig .b2{left:24%;top:0;width:18%;height:64%}
  #ctSig .b3{left:45%;top:6%;width:16%;height:58%}
  #ctSig .b4{left:63%;top:14%;width:13%;height:50%}
  #ctSig .tailL{left:0;top:48%;width:8%;height:12%}
  #ctSig .tailR{right:0;top:48%;width:8%;height:12%}
  #ctSig .kanji{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:'Noto Serif JP',serif;font-style:italic;font-weight:600;font-size:4.6cqw;letter-spacing:.14em;color:#d42a2a;
    text-shadow:0 0 8px rgba(212,42,42,.55),0 1px 0 rgba(0,0,0,.9)}
  #coverLore{position:absolute;left:6%;right:6%;bottom:31%;text-align:center;pointer-events:none;
    font-family:'EB Garamond',serif;font-style:italic;font-size:3.4cqw;line-height:1.5;color:#9aa7b2;
    opacity:0;transition:opacity .8s ease;text-shadow:0 2px 0 #000}
  #bootText{position:absolute;left:0;right:0;bottom:26%;text-align:center;
    font-family:'Press Start 2P',monospace;font-size:2.4cqw;color:#8f9ab0;letter-spacing:.24em;text-indent:.24em;
    animation:pulseTxt 1.8s ease-in-out infinite;text-shadow:0 2px 0 #000}
  #bootText.awake{animation:awaken 1.6s ease forwards;color:#b18cff;font-size:3cqw}
  @keyframes awaken{0%{opacity:0;text-shadow:0 0 0 rgba(177,140,255,0)}35%{opacity:1;text-shadow:0 0 18px rgba(177,140,255,.8)}
    60%{opacity:.85;text-shadow:0 0 10px rgba(177,140,255,.5)}100%{opacity:.9;text-shadow:0 0 8px rgba(177,140,255,.4)}}
  @keyframes pulseTxt{0%,100%{opacity:.5}50%{opacity:1}}
  #tapHint{position:absolute;left:0;right:0;bottom:26%;text-align:center;pointer-events:none;
    font-family:'Press Start 2P',monospace;font-size:2.6cqw;color:#ffd166;letter-spacing:.28em;text-indent:.28em;
    opacity:0;transition:opacity .9s ease;text-shadow:0 0 10px rgba(216,169,78,.5),0 3px 0 #000}
  #tapHint.show{opacity:1;animation:hintPulse 2.2s ease-in-out infinite}
  @keyframes hintPulse{0%,100%{opacity:.75}50%{opacity:1}}

  /* ============ COMIC ============ */
  #comicOverlay{position:absolute;inset:0;z-index:26;background:#020105;display:flex;align-items:center;justify-content:center;
    opacity:0;transition:opacity .4s ease}
  #comicOverlay.show{opacity:1}
  #comicImg{max-width:100%;max-height:100%;object-fit:contain}
  .cap{position:absolute;left:8%;right:8%;padding:2cqw 3cqw;pointer-events:none;
    font-family:'EB Garamond',serif;font-style:italic;font-size:3.6cqw;line-height:1.5;color:#f2ead8;
    text-shadow:0 2px 0 #000,0 0 8px rgba(0,0,0,.85);
    background:linear-gradient(180deg,rgba(2,1,4,.5),rgba(2,1,4,.78));
    border:1px solid rgba(242,234,216,.25)}
  .cap.top{top:4%}
  .cap.bottom{bottom:4%}

  /* ============ PADS ============ */
  #padLeft,#padRight{position:absolute;bottom:calc(8px + env(safe-area-inset-bottom,0px));z-index:6;display:none;pointer-events:none}
  body.touch.inplay #padLeft{display:flex;gap:8px;left:10px;align-items:flex-end}
  body.touch.inplay #padRight{display:grid;grid-template-columns:repeat(2,48px);gap:8px;right:10px}
  .pbtn{width:48px;height:48px;border-radius:50%;position:relative;overflow:hidden;background:rgba(13,8,20,.62);
    border:2px solid rgba(150,160,190,.38);box-shadow:0 0 0 1px rgba(0,0,0,.75), inset 0 0 10px rgba(0,0,0,.55), inset 0 0 2px rgba(214,224,240,.4);
    color:#c9b8ff;font-family:'Press Start 2P',monospace;font-size:13px;display:flex;align-items:center;justify-content:center;
    pointer-events:auto;touch-action:none;user-select:none;-webkit-user-select:none;opacity:.85;transition:transform .08s ease, background .08s ease}
  .pbtn.ability{border-color:rgba(122,80,220,.65)}
  .pbtn .cd{position:absolute;inset:0;pointer-events:none;border-radius:50%}
  .pbtn .cost{position:absolute;bottom:3px;right:6px;font-size:6px;color:#8f9ab0}
  .pbtn .sico{font-size:14px}
  .pbtn.empty{opacity:.35}
  .pbtn.ready{border-color:rgba(92,255,160,.8);color:#7dffc0;box-shadow:0 0 10px rgba(92,255,160,.35), inset 0 0 12px rgba(92,255,160,.22)}
  .pbtn.locked{opacity:.35;filter:grayscale(.85);border-color:#444a55}
  .pbtn:active{transform:scale(.88);background:rgba(122,80,220,.5)}

  #invBtn,#assignBtn{position:absolute;top:8px;z-index:7;width:34px;height:34px;padding:6px;display:none;
    background:rgba(13,8,20,.66);border:1px solid rgba(216,169,78,.55);border-radius:8px;box-shadow:0 0 0 1px #000;cursor:pointer}
  #invBtn{right:8px}
  #assignBtn{right:48px;font-family:'Press Start 2P',monospace;font-size:10px;color:#d8a94e;padding:0}
  #invBtn svg{width:100%;height:100%;display:block}

  /* ============ OVERLAYS ============ */
  .ovl{position:absolute;inset:0;z-index:12;display:flex;align-items:center;justify-content:center;background:rgba(4,2,9,.72)}
  .pnl{width:90%;max-height:94%;overflow:auto;background:linear-gradient(160deg,#181028 0%,#0c0716 65%);
    border:1px solid rgba(214,224,240,.35);box-shadow:0 0 0 1px #000, 0 0 46px rgba(122,80,220,.4), inset 0 0 30px rgba(0,0,0,.6);
    padding:3cqw;position:relative}
  .pnl h2{margin:0 0 1.6cqw;font-family:'Grenze Gotisch',serif;font-weight:600;font-size:5cqw;letter-spacing:.18em;color:#d8a94e;
    text-shadow:0 2px 0 #000, 0 0 14px rgba(216,169,78,.4)}
  .vline{font-family:'EB Garamond',serif;font-style:italic;font-size:3.2cqw;color:#9aa7b2;margin-bottom:2cqw}
  .goldline{font-family:'Press Start 2P',monospace;font-size:3cqw;color:#d8a94e;margin-bottom:2cqw}
  #tabBar{display:flex;gap:1.4cqw;margin-bottom:2cqw}
  .tab{flex:1;text-align:center}
  .tab.active{background:rgba(64,42,18,.55);border-color:#d8a94e;color:#ffd166}
  .cat{color:#b18cff;letter-spacing:.2em;font-family:'Press Start 2P',monospace;font-size:2.6cqw;margin:2cqw 0 1.2cqw}
  .irow{display:flex;gap:2.4cqw;align-items:center;border:1px solid rgba(122,80,220,.35);padding:1.8cqw;margin-bottom:1.4cqw;background:rgba(16,10,26,.6)}
  .icn{width:10cqw;height:10cqw;min-width:36px;min-height:36px;flex:none;image-rendering:pixelated;
    background-image:url('https://image.qwenlm.ai/public_source/de086523-4053-4904-8d82-f5f98bd17fc5/189d2f744-5e3b-4c80-9251-5b47aeaa0adb.png');
    background-size:300% 300%}
  .icn.heart{background-position:0% 0%}.icn.shard{background-position:50% 0%}.icn.gold{background-position:100% 0%}
  .icn.tincture{background-position:0% 50%}.icn.pewter{background-position:50% 50%}
  .icn.jester{background-position:0% 100%}.icn.page{background-position:50% 100%}
  .icn.grief{background-image:url('https://image.qwenlm.ai/public_source/de086523-4053-4904-8d82-f5f98bd17fc5/1457c9621-2876-433c-bb7b-90c06f84c8be.png');background-size:100% 100%}
  .icn.signet{background-image:url('https://image.qwenlm.ai/public_source/de086523-4053-4904-8d82-f5f98bd17fc5/17fce66db-6d20-475b-81a9-2a57f1832260.png');background-size:100% 100%}
  .irow .mid{flex:1;min-width:0}
  .irow .nm{font-family:'Grenze Gotisch',serif;color:#e8ecf5;font-size:3.8cqw}
  .irow .ds{font-family:'EB Garamond',serif;font-style:italic;color:#9aa7b2;font-size:3cqw}
  .irow .ct{font-family:'Press Start 2P',monospace;font-size:2.6cqw;color:#d8a94e}
  .vbtn{font-family:'Grenze Gotisch',serif;font-size:3.6cqw;letter-spacing:.12em;color:#d8a94e;background:rgba(20,12,34,.8);
    border:1px solid rgba(216,169,78,.6);padding:1.6cqw 2.6cqw;cursor:pointer}
  .vbtn:hover{background:rgba(64,42,18,.5)}
  .vbtn:disabled{opacity:.4;cursor:default}
  .vbtn.sel{background:rgba(64,42,18,.6);border-color:#ffd166;color:#ffd166}
  .sold{font-family:'Press Start 2P',monospace;font-size:2.4cqw;color:#69758a}
  .chp{width:34%;aspect-ratio:1/1;object-fit:cover;object-position:50% 30%;border:1px solid rgba(216,169,78,.6);display:block;margin:0 auto 2cqw}
  .chline{font-family:'EB Garamond',serif;font-size:3.2cqw;color:#cfd6e6;margin-bottom:1cqw}
  .chline b{color:#d8a94e}
  .sentry{display:flex;gap:2.4cqw;border:1px solid rgba(122,80,220,.35);padding:1.8cqw;margin-bottom:1.4cqw;background:rgba(16,10,26,.6)}
  .sicon{flex:none;width:9cqw;min-width:34px;text-align:center;font-size:5cqw;color:#7dffc0;text-shadow:0 0 8px rgba(92,255,160,.5)}
  .sentry .st{font-family:'Press Start 2P',monospace;font-size:2.4cqw;color:#8f9ab0;margin-top:.6cqw}
  .sentry .sl{font-family:'EB Garamond',serif;font-style:italic;font-size:2.9cqw;color:#69758a;margin-top:.6cqw}
  .sentry .su{font-family:'Press Start 2P',monospace;font-size:2.4cqw;color:#b18cff;margin-top:.6cqw}
  .tutline{font-family:'EB Garamond',serif;font-size:3.4cqw;color:#cfd6e6;margin-bottom:1.6cqw;line-height:1.5}
  .tutline b{color:#7dffc0}
  .srow,.prow{display:block;width:100%;margin-bottom:1.2cqw;text-align:left}

  /* ============ CHOICES ============ */
  #choiceOverlay{position:absolute;left:5%;right:5%;bottom:26%;z-index:14;display:flex;flex-direction:column;gap:1.6cqw}
  #choiceOverlay .jhint{font-family:'EB Garamond',serif;font-style:italic;font-size:3.2cqw;color:#9aa7b2;text-align:center;margin-bottom:.6cqw;text-shadow:0 2px 0 #000}
  #choiceOverlay .cbtn{font-family:'Grenze Gotisch',serif;font-size:3.8cqw;letter-spacing:.06em;color:#e8ecf5;
    background:rgba(10,6,16,.92);border:1px solid rgba(122,80,220,.55);padding:1.8cqw 2.6cqw;cursor:pointer;text-align:left}
  #choiceOverlay .cbtn:hover{border-color:#d8a94e;color:#ffd166}
  #choiceOverlay .cbtn .ctag{color:#b18cff;margin-right:1.4cqw}

  /* ============ LEVEL-UP ============ */
  #lvlOverlay{z-index:10;opacity:0;transition:opacity .25s ease}
  #lvlOverlay.show{opacity:1}
  #lvlOverlay.crumbling{opacity:0;transition:opacity .55s ease .05s}
  #lvlPanel{display:grid;grid-template-columns:44% 56%;gap:2cqw;height:92%;max-height:92%;overflow:hidden;padding:2cqw}
  #lvlPanel.crumble{animation:crumble .6s ease-in forwards}
  @keyframes crumble{0%{opacity:1;transform:none;filter:none}25%{transform:translateY(3px);filter:saturate(.7)}
    100%{opacity:0;transform:translateY(34px) scale(.97);filter:blur(6px) brightness(.55)}}
  .shardfx{position:absolute;background:linear-gradient(160deg,#1c1430,#0c0716);border:1px solid rgba(214,224,240,.28);pointer-events:none;z-index:2}
  #lvlLeft{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(180deg,#151022,#0a0714);border:1px solid rgba(214,224,240,.3)}
  #lvlLeft::before{content:'';position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(70% 45% at 50% 92%, rgba(122,80,220,.4), transparent 70%);
    animation:auraPulse 3.2s ease-in-out infinite}
  @keyframes auraPulse{0%,100%{opacity:.6}50%{opacity:1}}
  #portrait{position:relative;height:100%;width:100%;object-fit:cover;object-position:50% 35%;filter:saturate(1.02) contrast(1.05)}
  #lvlRight{display:flex;flex-direction:column;justify-content:center;gap:1.5cqw;overflow:hidden;text-align:left}
  .bk-name{font-family:'Grenze Gotisch',serif;font-size:5cqw;color:#e8ecf5;text-shadow:0 2px 0 #000}
  .bk-title{font-family:'EB Garamond',serif;font-size:3cqw;letter-spacing:.16em;color:#b18cff}
  .bk-lvl{font-family:'Press Start 2P',monospace;font-size:3cqw;color:#d8a94e;text-shadow:0 0 10px rgba(216,169,78,.5)}
  .bk-choose{font-family:'Grenze Gotisch',serif;font-size:4.2cqw;letter-spacing:.14em;color:#d8a94e;margin-top:1cqw}
  .trait{text-align:left;background:rgba(20,12,34,.72);border:1px solid rgba(122,80,220,.55);padding:2cqw 2.4cqw;color:#cfd6e6;
    cursor:pointer;position:relative;opacity:.9;pointer-events:none;font-family:'EB Garamond',serif}
  #lvlOverlay.armed .trait{pointer-events:auto}
  .trait .tname{font-family:'Grenze Gotisch',serif;font-size:4.2cqw;letter-spacing:.1em;color:#e8ecf5}
  .trait .tdesc{font-style:italic;font-size:3cqw;color:#9aa7b2;margin:.4cqw 0}
  .trait ul{margin:0;padding-left:4cqw;font-size:2.9cqw;color:#7dffc0}
  #lvlOverlay.armed .trait:hover{border-color:rgba(216,169,78,.8)}
  .trait.selected{border-color:#d8a94e;background:rgba(64,42,18,.4);box-shadow:0 0 18px rgba(216,169,78,.45), inset 0 0 14px rgba(216,169,78,.25)}
  .trait.flame{border-color:#eafff3}
  .trait.flame::before{content:'';position:absolute;inset:-3px;z-index:-1;background:linear-gradient(0deg,#7dffc0,#b18cff 60%,#eafff3);
    filter:blur(2px) drop-shadow(0 0 8px #7dffc0);animation:flameFlick .12s steps(2,end) infinite}
  .trait.flame::after{content:'';position:absolute;inset:-14px;z-index:-1;opacity:.95;pointer-events:none;
    background:
      radial-gradient(12% 42% at 8% 100%, rgba(125,255,192,.95), transparent 70%),
      radial-gradient(10% 34% at 26% 100%, rgba(177,140,255,.9), transparent 70%),
      radial-gradient(12% 46% at 45% 100%, rgba(125,255,192,.85), transparent 70%),
      radial-gradient(10% 36% at 64% 100%, rgba(234,255,243,.9), transparent 70%),
      radial-gradient(12% 42% at 82% 100%, rgba(177,140,255,.9), transparent 70%),
      radial-gradient(12% 42% at 8% 0%, rgba(125,255,192,.9), transparent 70%),
      radial-gradient(10% 34% at 30% 0%, rgba(234,255,243,.85), transparent 70%),
      radial-gradient(12% 46% at 52% 0%, rgba(177,140,255,.9), transparent 70%),
      radial-gradient(10% 36% at 72% 0%, rgba(125,255,192,.85), transparent 70%),
      radial-gradient(12% 42% at 90% 0%, rgba(234,255,243,.9), transparent 70%);
    animation:flameLick .12s steps(2,end) infinite}
  @keyframes flameLick{from{transform:translateY(0) scaleY(1)}to{transform:translateY(-3px) scaleY(1.07)}}
  @keyframes flameFlick{from{opacity:.8}to{opacity:1}}
  .bk-sealed{font-family:'EB Garamond',serif;font-style:italic;font-size:2.8cqw;color:#69758a}
  @media (max-width:560px){ #lvlPanel{grid-template-columns:40% 60%} }

  /* ============ GAME OVER / FINAL / FROZEN ============ */
  .overimg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.92}
  .overpanel{position:relative;z-index:2;margin-top:auto;width:100%;
    display:flex;flex-direction:column;align-items:center;gap:2cqw;padding:4cqw 0 5cqw;
    background:linear-gradient(to top, rgba(2,1,4,.95) 30%, transparent)}
  .overpanel h2{font-family:'Grenze Gotisch',serif;font-size:7cqw;letter-spacing:.14em;color:#ff4d6d;
    text-shadow:0 3px 0 #000,0 0 22px rgba(255,77,109,.5)}
  .contline{font-family:'Press Start 2P',monospace;font-size:3cqw;color:#d8a94e}
  .overbtns{display:flex;gap:2cqw;flex-wrap:wrap;justify-content:center}
  #overOverlay,#finalOverlay,#frozenOverlay{position:absolute;inset:0;z-index:28;display:flex;flex-direction:column;background:#020105}
  #finalOverlay{transition:background 1s ease}
  #finalOverlay.dark{background:#000}
  #finalImgB{opacity:0;transition:opacity .12s ease}
  #endPanel{position:absolute;left:0;right:0;bottom:0;z-index:3;display:none;flex-direction:column;align-items:center;gap:2cqw;
    padding:5cqw 0 6cqw;background:linear-gradient(to top, rgba(0,0,0,.96) 40%, transparent)}
  #endPanel h2{font-family:'Grenze Gotisch',serif;font-size:8cqw;letter-spacing:.16em;color:#ff4d6d;
    text-shadow:0 3px 0 #000,0 0 26px rgba(255,77,109,.55)}
  #frozenOverlay{background:#000}
</style>
</head>
<body>
<div id="stage">
  <canvas id="gameCanvas"></canvas>

  <div id="padLeft">
    <button class="pbtn" data-k="left">◀</button>
    <button class="pbtn" data-k="right">▶</button>
    <button class="pbtn" data-k="jump">▲</button>
  </div>
  <div id="padRight"></div>

  <button id="assignBtn" title="Assign Hotkeys">≡</button>
  <button id="invBtn" aria-label="Menu" title="Menu">
    <svg viewBox="0 0 24 24"><path d="M5 3h11l3 3v15H5z" fill="none" stroke="#d8a94e" stroke-width="1.6"/><path d="M9 3v18M9 8h6" stroke="#d8a94e" stroke-width="1.2"/></svg>
  </button>

  <div id="comicOverlay" hidden>
    <img id="comicImg" alt="">
    <div class="cap top" id="capTop"></div>
